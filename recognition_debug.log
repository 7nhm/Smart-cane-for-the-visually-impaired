# ================================================================
# IMPROVED FACE DETECTOR - CHÍNH XÁC HƠN
# ================================================================
class ImprovedFaceDetector:
    def __init__(self):
        self.face_cascade = None
        self.load_cascade()
        
    def load_cascade(self):
        """Tải cascade classifier chính xác hơn"""
        try:
            # Sử dụng cascade tốt hơn
            cascade_path = cv2.data.haarcascades + 'haarcascade_frontalface_alt2.xml'
            self.face_cascade = cv2.CascadeClassifier(cascade_path)
            
            if self.face_cascade.empty():
                cascade_path = cv2.data.haarcascades + 'haarcascade_frontalface_default.xml'
                self.face_cascade = cv2.CascadeClassifier(cascade_path)
            
            if not self.face_cascade.empty():
                print("✅ Improved Face cascade loaded")
            else:
                self.face_cascade = None
                print("❌ Cannot load any face cascade")
        except Exception as e:
            self.face_cascade = None
            print(f"❌ Cascade load error: {e}")
    
    def enhance_image(self, frame):
        """Cải thiện chất lượng ảnh trước khi nhận diện"""
        if frame is None:
            return None
            
        try:
            # Tăng contrast với CLAHE
            lab = cv2.cvtColor(frame, cv2.COLOR_BGR2LAB)
            l, a, b = cv2.split(lab)
            clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
            cl = clahe.apply(l)
            limg = cv2.merge((cl, a, b))
            enhanced = cv2.cvtColor(limg, cv2.COLOR_LAB2BGR)
            
            # Giảm noise nhẹ
            enhanced = cv2.fastNlMeansDenoisingColored(enhanced, None, 5, 5, 7, 15)
            
            return enhanced
        except:
            return frame
    
    def detect_faces_accurate(self, frame):
        """
        Phát hiện khuôn mặt CHÍNH XÁC với pre-processing
        Trả về list boxes [(x, y, w, h), ...]
        """
        global face_stability_counter, last_stable_face, face_history
        
        if self.face_cascade is None or frame is None:
            return []
        
        try:
            # Cải thiện chất lượng ảnh
            enhanced_frame = self.enhance_image(frame)
            if enhanced_frame is None:
                enhanced_frame = frame
            
            # Resize để tăng tốc nhưng vẫn giữ chất lượng
            height, width = frame.shape[:2]
            
            if width > 480:
                scale = 480 / width
                small_w = 480
                small_h = int(height * scale)
                small_frame = cv2.resize(enhanced_frame, (small_w, small_h))
            else:
                small_frame = enhanced_frame
                scale = 1.0
            
            # Chuyển sang grayscale với gamma correction
            gray = cv2.cvtColor(small_frame, cv2.COLOR_BGR2GRAY)
            
            # Gamma correction cho ánh sáng yếu
            gray = np.array(255 * (gray / 255) ** 1.2, dtype=np.uint8)
            
            # Làm mờ vừa phải
            gray = cv2.GaussianBlur(gray, (5, 5), 1.5)
            
            # Phát hiện khuôn mặt với tham số CHÍNH XÁC
            faces = self.face_cascade.detectMultiScale(
                gray,
                scaleFactor=1.05,       # Giảm để tăng độ chính xác
                minNeighbors=6,         # TĂNG để giảm false positive
                minSize=(70, 70),       # TĂNG kích thước tối thiểu
                maxSize=(300, 300),     # TĂNG kích thước tối đa
                flags=cv2.CASCADE_SCALE_IMAGE
            )
            
            if len(faces) == 0:
                # Không có khuôn mặt, giảm stability
                face_stability_counter = max(0, face_stability_counter - 2)
                return []
            
            # Lọc khuôn mặt kỹ càng hơn
            valid_faces = []
            for (x, y, w, h) in faces:
                # Scale lại tọa độ
                if scale != 1.0:
                    x, y, w, h = int(x/scale), int(y/scale), int(w/scale), int(h/scale)
                
                # Kiểm tra kích thước cơ bản
                if w < MIN_FACE_WIDTH or h < MIN_FACE_HEIGHT:
                    continue
                
                # Kiểm tra diện tích
                face_area = w * h
                if face_area < FACE_AREA_MIN:
                    continue
                
                # Kiểm tra aspect ratio (tỷ lệ khung hình khuôn mặt)
                aspect_ratio = w / h
                if aspect_ratio < 0.7 or aspect_ratio > 1.3:  # Thu hẹp ngưỡng
                    continue
                
                # Kiểm tra vị trí (ưu tiên khuôn mặt ở giữa ảnh)
                center_x = x + w/2
                center_y = y + h/2
                img_center_x = width / 2
                img_center_y = height / 2
                
                # Tính khoảng cách đến trung tâm
                distance_to_center = np.sqrt((center_x - img_center_x)**2 + (center_y - img_center_y)**2)
                
                # Ưu tiên khuôn mặt gần trung tâm
                if distance_to_center > width * 0.4:  # Quá xa trung tâm
                    continue
                
                valid_faces.append((x, y, w, h, face_area, distance_to_center))
            
            if len(valid_faces) == 0:
                face_stability_counter = max(0, face_stability_counter - 1)
                return []
            
            # Sắp xếp theo: 1) Gần trung tâm, 2) Diện tích lớn
            valid_faces.sort(key=lambda f: (f[5], -f[4]))  # distance (tăng), area (giảm)
            
            if len(valid_faces) > MAX_FACES:
                valid_faces = valid_faces[:MAX_FACES]
            
            # Chỉ lấy tọa độ
            final_faces = [(x, y, w, h) for (x, y, w, h, _, _) in valid_faces]
            
            # Kiểm tra tính ổn định
            current_face = final_faces[0] if final_faces else None
            
            if current_face:
                face_history.append(current_face)
                
                if len(face_history) >= 2:
                    # Kiểm tra độ ổn định qua các frame
                    last_face = face_history[-2] if len(face_history) >= 2 else None
                    
                    if last_face:
                        # Tính sự thay đổi vị trí
                        x1, y1, w1, h1 = current_face
                        x2, y2, w2, h2 = last_face
                        
                        center_change = np.sqrt((x1 + w1/2 - x2 - w2/2)**2 + 
                                               (y1 + h1/2 - y2 - h2/2)**2)
                        size_change = abs(w1 - w2) + abs(h1 - h2)
                        
                        # Nếu ổn định (ít thay đổi)
                        if center_change < FACE_MOVEMENT_THRESHOLD and size_change < 20:
                            face_stability_counter += 1
                        else:
                            face_stability_counter = max(0, face_stability_counter - 1)
                    
                    # Giới hạn stability counter
                    if face_stability_counter > FACE_STABILITY_THRESHOLD * 3:
                        face_stability_counter = FACE_STABILITY_THRESHOLD * 3
                    
                    if face_stability_counter >= FACE_STABILITY_THRESHOLD:
                        last_stable_face = current_face
                        if face_stability_counter == FACE_STABILITY_THRESHOLD:
                            print(f"✅ [FACE] Face detected and STABLE: {current_face[2]}x{current_face[3]}")
            
            return final_faces if face_stability_counter >= FACE_STABILITY_THRESHOLD else []
            
        except Exception as e:
            print(f"⚠️ Face detection error: {e}")
            return []

# Khởi tạo face detector
face_detector = ImprovedFaceDetector()

