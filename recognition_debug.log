MIN_FACE_WIDTH = 80                   # TĂNG kích thước tối thiểu
MIN_FACE_HEIGHT = 80
FACE_AREA_MIN = 4000                  # TĂNG diện tích tối thiểu
MAX_FACES = 1                         # Chỉ tập trung 1 khuôn mặt chính
FACE_STABILITY_THRESHOLD = 3          # Cần 3 frame ổn định để đảm bảo
