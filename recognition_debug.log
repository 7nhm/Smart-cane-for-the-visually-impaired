# MAIN
# ================================================================
if __name__ == "__main__":
    print("🚀 RTSP SYSTEM - FACE PRIORITY MODE")
    
    start_rtsp_system()
    
    try:
        # Main loop
        while True:
            # Hiển thị status mỗi 15 giây
            time.sleep(15)
            
            print(f"\n📊 SYSTEM STATUS:")
            print(f"  Camera: {'✅ Connected' if camera_connected else '❌ Disconnected'}")
            print(f"  Face Tracking: {len(current_people)} people")
            
            if len(current_people) > 0:
                recent = list(current_people.keys())[:3]
                print(f"  Recent Faces: {recent}")
            
            print(f"  Face Boxes: {len(face_boxes)}")
            print(f"  Face Stability: {face_stability_counter}/{FACE_STABILITY_THRESHOLD}")
            
            priority_status = update_priority_status()
            print(f"  Priority Status: {priority_status}")
            print(f"  Time since last face: {time.time() - last_face_detected_time:.1f}s")
            
            if OBSTACLE_DETECTION_ENABLED:
                close_obstacles = len([o for o in obstacle_boxes if o.get('estimated_distance', 999) <= OBSTACLE_DISTANCE_THRESHOLD])
                print(f"  Obstacles (<1m): {close_obstacles}")
            
    except KeyboardInterrupt:
        print("\nStopping system...")
    finally:
        stop_rtsp_system()